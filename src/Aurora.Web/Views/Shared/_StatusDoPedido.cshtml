@* Status do pedido em texto dentro de uma etiqueta colorida: a cor reforça, mas nunca é a única informação *@
@model string
@{
    var classe = Model switch
    {
        SituacaoDoPedido.Aberto => "text-bg-secondary",
        SituacaoDoPedido.Confirmado => "text-bg-primary",
        SituacaoDoPedido.EmProducao => "text-bg-info",
        SituacaoDoPedido.Pronto => "text-bg-success",
        SituacaoDoPedido.Expedido => "text-bg-dark",
        SituacaoDoPedido.Cancelado => "text-bg-danger",
        _ => "text-bg-light",
    };
}
<span class="badge @classe">@Formatacao.StatusDoPedido(Model)</span>
