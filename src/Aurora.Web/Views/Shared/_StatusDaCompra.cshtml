@* Status do pedido de compra em texto dentro de uma etiqueta colorida: a cor reforça, mas nunca é a única informação *@
@model string
@{
    var classe = Model switch
    {
        SituacaoDaCompra.Solicitado => "text-bg-secondary",
        SituacaoDaCompra.Emitido => "text-bg-primary",
        SituacaoDaCompra.ParcialmenteRecebido => "text-bg-info",
        SituacaoDaCompra.Recebido => "text-bg-success",
        SituacaoDaCompra.Cancelado => "text-bg-danger",
        _ => "text-bg-light",
    };
}
<span class="badge @classe">@Formatacao.StatusDaCompra(Model)</span>
