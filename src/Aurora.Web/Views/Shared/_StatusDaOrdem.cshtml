@* Situação da OP ou da etapa em texto dentro de uma etiqueta colorida: a cor reforça, mas nunca é a única informação *@
@model string
@{
    var classe = Model switch
    {
        SituacaoDaOrdem.Planejada or SituacaoDaEtapa.Pendente => "text-bg-secondary",
        SituacaoDaOrdem.EmAndamento => "text-bg-info",
        SituacaoDaOrdem.Concluida => "text-bg-success",
        SituacaoDaOrdem.Cancelada => "text-bg-danger",
        _ => "text-bg-light",
    };
}
<span class="badge @classe">@Formatacao.StatusDaOrdem(Model)</span>
